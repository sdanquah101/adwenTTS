{
  "name": "adwen-maths",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive BECE mathematics lessons: diagnose, profile, teach, check",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
