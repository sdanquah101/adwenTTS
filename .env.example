# Runtime environment: development | test | production
NODE_ENV=development
# Interface and port the HTTP server binds to
HOST=0.0.0.0
PORT=3000
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Base URL of the Python inference worker (see worker/). Leave unset to disable TTS routes.
# INFERENCE_URL=http://localhost:8000
